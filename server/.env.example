# Copy to .env on the server and fill in real values.

APP_NAME=posture-monitor-api
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# MySQL runs on the same server. Keep it bound to localhost.
DATABASE_URL=mysql+pymysql://posture_user:CHANGE_ME@127.0.0.1:3306/posture_monitor?charset=utf8mb4

# OneNET credentials are used in later milestones. Do not commit real tokens.
ONENET_PRODUCT_ID=YOUR_PRODUCT_ID
ONENET_DEVICE_NAME=YOUR_DEVICE_NAME
ONENET_TOKEN=YOUR_DEVICE_TOKEN
